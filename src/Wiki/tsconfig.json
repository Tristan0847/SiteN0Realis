{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "noEmit": true,
        "paths": {
            "@Wiki/*": [
                "../Wiki/*"
            ],
            "@lib/*": [
                "../lib/*"
            ],
            "contentlayer2/generated": [
                "./.contentlayer/generated"
            ]
        }
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".contentlayer/generated"
    ]
}
