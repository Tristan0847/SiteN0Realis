{
    "name": "blog-de-vacare-frontend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "node scripts/setBuildMode.js dev && next dev --turbopack -p 3002",
        "export:data": "bash scripts/export-medias.sh && tsx scripts/export-data.ts",
        "build": "node scripts/setBuildMode.js build && next build",
        "build:export": "npm run export:data && node scripts/setBuildMode.js export && next build",
        "start": "next start -p 3002",
        "export": "next export",
        "lint": "eslint"
    },
    "dependencies": {
        "@headlessui/react": "*",
        "@tanstack/react-query": "*",
        "react": "*",
        "react-dom": "*",
        "react-markdown": "*",
        "next": "*",
        "dotenv": "*",
        "lib": "*"
    },
    "devDependencies": {
        "typescript": "*",
        "@types/node": "*",
        "@types/react": "*",
        "@types/react-dom": "*",
        "@tailwindcss/postcss": "*",
        "tailwindcss": "*",
        "autoprefixer": "*",
        "eslint": "*",
        "eslint-config-next": "*",
        "@eslint/eslintrc": "*"
    }
}
